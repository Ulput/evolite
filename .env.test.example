# Copy to .env.test.local (never committed) for the live tests.
# A testnet recovery phrase whose addresses hold some coins (for example from the faucet).
EVOLITE_TEST_PHRASE=
# DPNS names (without @) of two identities of that phrase: the first one's and a second one's
# (live_identity_found_and_created makes the second). Used by the DashPay, credits and NFT tests.
EVOLITE_TEST_NAME=
EVOLITE_TEST_NAME_2=
# A file whose first line is a second test wallet's phrase (wallet B), for live_app_sign_in.
EVOLITE_APP_TEST_IDENTITY=
#
# Not read from this file: screenshots of the real wallet (`--open`, a build with
# `--features evolite-ui/dev-tools`) take the vault's password from the environment variable
# EVOLITE_SHOT_PASSWORD and wait EVOLITE_SHOT_SETTLE seconds after the sync (15 by default).
