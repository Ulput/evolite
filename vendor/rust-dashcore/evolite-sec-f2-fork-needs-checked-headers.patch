+    /// evolite (security): a batch whose first header's parent we don't store is not
+    /// validated, so it starts no fork even when that first header is one we store and the
+    /// next branches off below our tip claiming far more work, with no proof of work. Not
+    /// held, nothing trimmed, nobody banned; synced, its peer is asked with our locator.
+    #[tokio::test]
+    async fn an_unvalidated_batch_behind_a_stored_header_starts_no_fork() {
+        let ours = mined_chain(BlockHash::dummy(0), 5, EASY, 0);
+        let (mut manager, _storage) = fork_manager(FORK_BASE, &ours).await;
+        let (requests, mut rx) = create_test_request_sender();
+        let forged = Header {
+            prev_blockhash: *ours[2].hash(),
+            bits: dashcore::CompactTarget::from_consensus(0x0300_0001),
+            ..Header::dummy(0)
+        };
+        assert!(!forged.target().is_met_by(forged.block_hash()), "no proof of work");
+
+        let batch = [ours[0].clone(), forged.into()];
+        let result = manager.handle_headers_pipeline(peer(), &batch, &requests).await;
+
+        assert!(result.is_ok(), "{result:?}");
+        assert_eq!(fork_detected(&result), None, "{result:?}");
+        assert!(manager.fork.is_none(), "not held");
+        assert_eq!(manager.tip().await.unwrap().height(), FORK_BASE + 4, "nothing trimmed");
+        let sent = sent(&mut rx);
+        assert!(sent.banned.is_empty(), "{sent:?}");
+        let to: Vec<_> = sent.locators.iter().map(|(to, _)| *to).collect();
+        assert_eq!(to, vec![Some(peer())]);
+    }
+
