+    /// The IS lock of the mainnet fixture's cycle (`TestEngine::mainnet_fixture`), signed by its
+    /// quorum; the same lock `validation::instantlock`'s tests verify.
+    fn genuine_lock() -> InstantLock {
+        dashcore::consensus::deserialize(&hex_conservative::decode_to_vec("").unwrap()).unwrap()
+    }
+
+    /// The genuine lock with a garbage (non-zero) signature: well-formed, so it passes the
+    /// structure check, but it never verifies.
+    fn forged_lock() -> InstantLock {
+        InstantLock {
+            signature: BLSSignature::from([1u8; 96]),
+            ..genuine_lock()
+        }
+    }
+
+    /// evolite (security): a forged lock that a peer sends first for a txid must not shadow the
+    /// genuine one that follows. The genuine lock is verified, sent `validated: true` and cached
+    /// as the txid's lock; only then are later locks for the txid ignored.
+    #[tokio::test]
+    async fn a_forged_lock_sent_first_does_not_shadow_the_genuine_one() {
+        let engine = TestEngine::mainnet_fixture();
+        let mut manager: TestInstantSendManager =
+            InstantSendManager::new(Arc::new(RwLock::new(engine)));
+        let genuine = genuine_lock();
+        let txid = genuine.txid;
+
+        let events = manager.process_instantlock(&forged_lock()).await.unwrap();
+        assert!(
+            matches!(
+                events.as_slice(),
+                [SyncEvent::InstantLockReceived {
+                    validated: false,
+                    ..
+                }]
+            ),
+            "{events:?}"
+        );
+        assert!(!manager.is_transaction_locked(&txid));
+
+        let events = manager.process_instantlock(&genuine).await.unwrap();
+        match events.as_slice() {
+            [SyncEvent::InstantLockReceived {
+                instant_lock,
+                validated: true,
+            }] => assert_eq!(instant_lock, &genuine),
+            other => panic!("expected the genuine lock sent verified, got {other:?}"),
+        }
+        let entry = manager.get_instantlock(&txid).expect("cached");
+        assert!(entry.validated);
+        assert_eq!(entry.instant_lock, genuine);
+
+        // Verified, the txid's lock now suppresses any other.
+        assert!(manager.process_instantlock(&forged_lock()).await.unwrap().is_empty());
+        assert_eq!(manager.get_instantlock(&txid).expect("cached").instant_lock, genuine);
+    }
+
+    /// evolite (security audit F8, review r1 Should 1): many forged locks for one txid take at most
+    /// `MAX_PENDING_PER_TXID` places; those already waiting stay, and another txid's lock is still
+    /// queued.
+    #[tokio::test]
+    async fn forged_locks_for_one_txid_take_a_few_places_only() {
+        let mut manager = create_test_manager();
+        let genuine = genuine_lock();
+        let _ = manager.process_instantlock(&genuine).await.unwrap();
+        for n in 1..=6u8 {
+            let forged = InstantLock {
+                signature: BLSSignature::from([n; 96]),
+                ..genuine_lock()
+            };
+            let _ = manager.process_instantlock(&forged).await.unwrap();
+        }
+        assert_eq!(manager.pending_count(), MAX_PENDING_PER_TXID);
+        assert!(
+            manager.pending_instantlocks.iter().any(|p| p.instant_lock == genuine),
+            "the one waiting first stays"
+        );
+        let other = InstantLock {
+            txid: Txid::from_byte_array([3u8; 32]),
+            ..genuine_lock()
+        };
+        let _ = manager.process_instantlock(&other).await.unwrap();
+        assert_eq!(manager.pending_count(), MAX_PENDING_PER_TXID + 1, "another txid's is queued");
+    }
+
+    /// evolite (security): both locks arrive before their cycle's quorum is known, the forged one
+    /// first. Both are kept pending; once the quorum lands, the lock that verifies is the one
+    /// cached as validated (not the forged entry merely marked so), and the forged one, now
+    /// superseded, is dropped.
+    #[tokio::test]
+    async fn the_pending_lock_that_verifies_is_the_one_cached() {
+        let mut manager = create_test_manager();
+        let genuine = genuine_lock();
+        let txid = genuine.txid;
+
+        let _ = manager.process_instantlock(&forged_lock()).await.unwrap();
+        let _ = manager.process_instantlock(&genuine).await.unwrap();
+        assert_eq!(manager.pending_count(), 2, "the genuine lock is queued, not a duplicate");
+        assert!(!manager.is_transaction_locked(&txid));
+
+        *manager.engine.write().await = TestEngine::mainnet_fixture();
+        let events = manager.validate_pending(Instant::now()).await.unwrap();
+        match events.as_slice() {
+            [SyncEvent::InstantLockReceived {
+                instant_lock,
+                validated: true,
+            }] => assert_eq!(instant_lock, &genuine),
+            other => panic!("expected the genuine lock sent verified, got {other:?}"),
+        }
+        let entry = manager.get_instantlock(&txid).expect("cached");
+        assert!(entry.validated);
+        assert_eq!(entry.instant_lock, genuine);
+
+        let events = manager.validate_pending(Instant::now()).await.unwrap();
+        assert!(events.is_empty());
+        assert_eq!(manager.pending_count(), 0, "the superseded forged lock is dropped");
+    }
